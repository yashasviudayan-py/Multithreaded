# Server bind address
HOST=0.0.0.0
PORT=8080

# Tokio worker thread count (defaults to number of CPU cores)
WORKERS=4

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# Directory to serve static files from
STATIC_DIR=./static

# Token-bucket rate limiter: max requests per second per client IP
RATE_LIMIT_RPS=100

# Maximum concurrent connections (backpressure threshold)
MAX_CONNECTIONS=10000

# Database. SQLite is suitable for a single-node deployment.
DATABASE_URL=sqlite:./data.db
DB_POOL_SIZE=5

# Authentication bootstrap. On the first start an admin account is created in
# the database with an Argon2id password hash. For production, generate a hash
# with `cargo run --quiet --bin password_hash -- 'choose-a-password'` and set
# AUTH_PASSWORD_HASH instead of putting a plaintext password in this file.
AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=$argon2id$...
# AUTH_PASSWORD=change-this-development-only
JWT_SECRET=replace-with-a-long-random-secret

# Session cookies become Secure automatically when both TLS paths are set.
# TLS_CERT_PATH=/etc/ssl/certs/server.crt
# TLS_KEY_PATH=/etc/ssl/private/server.key

# --- Phase 7: HTTPS / TLS (uncomment when enabling HTTPS) ---
# TLS_CERT_PATH=/etc/ssl/certs/server.crt
# TLS_KEY_PATH=/etc/ssl/private/server.key
